// Fase 0 — fundacao do ERP de viabilidade e gestao financeira de empreendimentos imobiliarios.
//
// Convencao deste schema: todo valor monetario ou percentual e armazenado como
// String (texto decimal), nunca Float/Real. SQLite nao possui tipo Decimal nativo
// no Prisma, e ponto flutuante binario pode introduzir deriva de arredondamento
// entre execucoes — o que violaria o principio de motor financeiro deterministico
// (ver docs/ARQUITETURA.md, principio B). A camada core/ converte para Decimal.js
// na fronteira de leitura/escrita.
//
// Nenhuma tabela abaixo tem coluna ou valor especifico do Splendido — Splendido
// e apenas o primeiro conjunto de linhas inserido nestas tabelas genericas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/**
 * Autenticacao e permissoes — unico, opaco token de sessao guardado em
 * cookie httpOnly (nao JWT: um token aleatorio verificado contra esta
 * tabela e o padrao mais simples de auditar/revogar, consistente com o
 * resto do sistema preferir estado explicito no banco a esperteza).
 * papel: "admin" (acesso completo a TODOS os empreendimentos, incluindo
 * excluir) | "usuario" (visualiza e cadastra, nao exclui, e só nos
 * empreendimentos vinculados via EmpreendimentoUsuario — ver esse modelo) |
 * "stakeholder" (Fase 2.5 — visualizacao apenas, so nos empreendimentos
 * vinculados, e o vinculo nunca pode ser "edicao" — validado em
 * api/src/app.ts, POST /api/usuarios/:id/empreendimentos).
 */
model Usuario {
  id         String   @id @default(cuid())
  email      String   @unique
  nome       String
  senhaHash  String
  papel      String   @default("usuario") // admin | usuario | stakeholder
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sessoes      Sessao[]
  empreendimentos EmpreendimentoUsuario[]

  @@map("usuario")
}

model Sessao {
  id        String   @id @default(cuid())
  usuarioId String
  token     String   @unique
  expiraEm  DateTime
  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("sessao")
}

/**
 * Vinculo usuario<->empreendimento (achado da nona fatia, docs/DECISOES.md
 * F5): so tem efeito para usuario.papel="usuario" — admin sempre tem acesso
 * a todos os empreendimentos, com ou sem linha aqui. Cadastrar um
 * empreendimento vincula automaticamente quem criou (ver
 * POST /api/empreendimentos), senao a pessoa criava algo que nao conseguia
 * mais ver.
 */
/**
 * Vinculo de acesso usuario x empreendimento (achado F5). Estendido (achado
 * F23, docs/DECISOES.md — "permissao por empreendimento com papel proprio")
 * com `papel`: "edicao" (padrao, comportamento identico a antes desta
 * fatia — acesso total dentro do empreendimento) ou "leitura" (bloqueia
 * qualquer metodo != GET nas rotas escopadas a este empreendimento, ver
 * garantirAcesso em api/src/app.ts). Dimensao independente do
 * Usuario.papel global ("admin"/"usuario") -- um "usuario" pode ter edicao
 * num empreendimento e leitura em outro.
 */
model EmpreendimentoUsuario {
  id               String   @id @default(cuid())
  empreendimentoId String
  usuarioId        String
  papel            String   @default("edicao") // edicao | leitura
  createdAt        DateTime @default(now())

  empreendimento Empreendimento @relation(fields: [empreendimentoId], references: [id])
  usuario        Usuario        @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, empreendimentoId])
  @@map("empreendimento_usuario")
}

model Empreendimento {
  id                    String    @id @default(cuid())
  nome                  String
  incorporador          String?
  endereco              String?
  statusFase            String?
  dataPrevistaConclusao DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  cenarios            Cenario[]
  terrenos            Terreno[]
  tipologias          Tipologia[]
  unidades            Unidade[]
  condicoesPagamento  CondicaoPagamento[]
  premissasVelocidade PremissaVelocidadeVendas[]
  vendas              Venda[]
  categoriasCusto     CategoriaCusto[]
  custos              Custo[]
  cronograma          CronogramaFisicoFinanceiro[]
  permutas            Permuta[]
  usuariosVinculados  EmpreendimentoUsuario[]
  indicesCorrecao     IndiceCorrecao[]
  distratos           Distrato[]
  renegociacoesVenda  RenegociacaoVenda[]
  financiamentos      FinanciamentoProducao[]

  @@map("empreendimento")
}

model Cenario {
  id                     String   @id @default(cuid())
  empreendimentoId       String
  tipo                   String // base | otimista | pessimista | personalizado
  nome                   String
  derivadoDeCenarioId    String?
  horizonteProjecaoMeses Int
  // Limite de risco configuravel (achado F15, docs/DECISOES.md — "alertas
  // de risco configuraveis"): nulo = usa o padrao de 30% definido no
  // motor (LIMITE_NECESSIDADE_MAXIMA_SOBRE_VGV_PADRAO); preenchido, o
  // alerta "necessidade_maxima_alta" passa a disparar acima deste valor.
  limiteNecessidadeMaximaCapital String? // decimal-as-string, 0..1
  // Ancora de calendario para a importacao de extrato bancario (achado
  // F27, docs/DECISOES.md): o "mes" em todo o sistema sempre foi um
  // inteiro relativo (mes 1, mes 2...), nunca uma data real -- nulo =
  // cenario sem ancora, a conciliacao por extrato so casa por valor,
  // sem sugerir por proximidade de data. Preenchido, `dataMesUm`
  // e a data de calendario correspondente ao mes 1 deste cenario.
  dataMesUm              DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  empreendimento Empreendimento @relation(fields: [empreendimentoId], references: [id])
  derivadoDe     Cenario?       @relation("CenarioDerivado", fields: [derivadoDeCenarioId], references: [id])
  derivados      Cenario[]      @relation("CenarioDerivado")

  premissasVelocidade PremissaVelocidadeVendas[]
  vendas              Venda[]
  custos              Custo[]
  cronograma          CronogramaFisicoFinanceiro[]
  indicesCorrecao     IndiceCorrecao[]
  financiamento       FinanciamentoProducao?

  @@map("cenario")
}

/**
 * Uma matricula/registro de area que compoe o terreno de um empreendimento
 * (achado F26, docs/DECISOES.md — "multiplas matriculas/areas por
 * empreendimento"). Ate essa fatia era 1:1 com Empreendimento
 * (empreendimentoId @unique); um empreendimento real muitas vezes reune
 * mais de uma matricula (lotes contiguos comprados separadamente) -- isso
 * fecha a lacuna deliberadamente deixada de fora na Fase 0, onde o
 * `RegistroAreaTerreno` original da especificacao foi simplificado para
 * `Terreno.areaObservacao` (texto livre). Continua nunca lido pelo motor
 * financeiro, mesmo espirito de Permuta/Distrato -- so cadastro.
 */
model Terreno {
  id                  String   @id @default(cuid())
  empreendimentoId    String
  numeroMatricula     String? // identificador livre da matricula/registro (ex.: numero no cartorio)
  areaValor           String? // decimal-as-string; nulo = nao validado/conflitante
  areaUnidade         String   @default("m2")
  areaStatusValidacao String   @default("pendente") // pendente | validado | conflitante
  areaObservacao      String?
  formaAquisicao      String? // compra | permuta | misto
  createdAt           DateTime @default(now())
  updatedAt            DateTime @updatedAt

  empreendimento Empreendimento @relation(fields: [empreendimentoId], references: [id])

  @@map("terreno")
}

model Tipologia {
  id                  String   @id @default(cuid())
  empreendimentoId    String
  nome                String
  areaPrivativaPadrao String?
  precoUnitarioPadrao String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  empreendimento      Empreendimento             @relation(fields: [empreendimentoId], references: [id])
  unidades            Unidade[]
  condicoesPagamento  CondicaoPagamento[]
  premissasVelocidade PremissaVelocidadeVendas[]
  custos              Custo[]

  @@map("tipologia")
}

model Unidade {
  id               String   @id @default(cuid())
  empreendimentoId String
  tipologiaId      String
  numero           String
  andar            Int?
  orientacao       String?
  areaPrivativa    String?
  precoVenda       String?
  status           String   @default("estoque") // estoque | reservada | vendida | permutada | distratada | indisponivel
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  empreendimento Empreendimento @relation(fields: [empreendimentoId], references: [id])
  tipologia      Tipologia      @relation(fields: [tipologiaId], references: [id])
  vendas         Venda[]
  permuta        Permuta?

  @@map("unidade")
}

/**
 * Cadastro nominal completo de uma permuta (achado F3, docs/DECISOES.md:
 * Unidade.status='permutada' ja e suficiente para o motor financeiro —
 * exclui a unidade do estoque disponivel e do VGV de venda — mas nao
 * registra quem recebeu o que. Esta tabela e so isso: um registro, nunca
 * lida pelo motor.
 */
model Permuta {
  id               String    @id @default(cuid())
  empreendimentoId String
  unidadeId        String    @unique
  nomeContraparte  String
  documento        String?
  valorAtribuido   String? // decimal-as-string, so para registro -- nao participa do motor
  dataAcordo       DateTime?
  observacao       String?
  createdAt        DateTime  @default(now())

  empreendimento Empreendimento @relation(fields: [empreendimentoId], references: [id])
  unidade        Unidade        @relation(fields: [unidadeId], references: [id])
  contrapartes   ContrapartePermuta[]

  @@map("permuta")
}

/**
 * Permuta parcial (achado F24, docs/DECISOES.md — "permuta parcial: dividir
 * uma unidade entre multiplas contrapartes"): cadastro nominal de quem mais
 * divide a mesma permuta com a contraparte principal (Permuta.nomeContraparte)
 * -- ex.: um terreno permutado que pertencia a varios herdeiros/socios, cada
 * um recebendo uma fatia da unidade dada em troca. Mesmo espirito de
 * DestinatarioComissao (achado F13): puramente informativo, nunca lido pelo
 * motor -- a soma de percentualSplit nunca pode ultrapassar 100%, validado
 * na API.
 */
model ContrapartePermuta {
  id              String   @id @default(cuid())
  permutaId       String
  nome            String
  documento       String?
  percentualSplit String // decimal-as-string, 0..1 -- fatia desta permuta que esta contraparte recebe
  valorAtribuido  String? // decimal-as-string, so para registro -- nao participa do motor
  createdAt       DateTime @default(now())

  // onDelete: Cascade (fechamento/hardening da Fase 1, docs/DECISOES.md —
  // achado F29): ContrapartePermuta so existe em funcao de uma Permuta,
  // nunca tem sentido de negocio independente -- apagar a Permuta deve
  // sempre apagar suas contrapartes junto, sem depender de codigo de
  // aplicacao lembrar de fazer isso em todo caminho que apaga Permuta em
  // lote (excluirEmpreendimento, por exemplo).
  permuta Permuta @relation(fields: [permutaId], references: [id], onDelete: Cascade)

  @@map("contraparte_permuta")
}

model CondicaoPagamento {
  id               String   @id @default(cuid())
  empreendimentoId String
  tipologiaId      String?
  nome             String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  empreendimento Empreendimento        @relation(fields: [empreendimentoId], references: [id])
  tipologia      Tipologia?            @relation(fields: [tipologiaId], references: [id])
  modalidades    ModalidadePagamento[]
  vendas         Venda[]

  @@map("condicao_pagamento")
}

model ModalidadePagamento {
  id                   String   @id @default(cuid())
  condicaoPagamentoId  String
  nome                 String
  percentual           String // decimal-as-string, 0..1
  tipoDistribuicao     String // unica | nivelada | periodica | sobre_total
  periodicidadeMeses   Int?
  mesFixo              Int?
  repeticoesSobreTotal Int      @default(1)
  geraEventoParcial    Boolean  @default(false)
  ordem                Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  condicaoPagamento CondicaoPagamento      @relation(fields: [condicaoPagamentoId], references: [id])
  recebimentos      RecebimentoProjetado[]

  @@map("modalidade_pagamento")
}

model PremissaVelocidadeVendas {
  id                String @id @default(cuid())
  empreendimentoId  String
  cenarioId         String
  tipologiaId       String
  mes               Int
  unidadesPrevistas String // decimal-as-string

  empreendimento Empreendimento @relation(fields: [empreendimentoId], references: [id])
  cenario        Cenario        @relation(fields: [cenarioId], references: [id])
  tipologia      Tipologia      @relation(fields: [tipologiaId], references: [id])

  @@map("premissa_velocidade_vendas")
}

model Venda {
  id                  String   @id @default(cuid())
  empreendimentoId    String
  cenarioId           String
  unidadeId           String
  mesOrigem           Int
  valorVenda          String // decimal-as-string
  condicaoPagamentoId String
  status              String   @default("ativa") // ativa | distratada
  // Cadastro nominal do comprador (Fase 2, tela de Vendas) -- mesmo espirito
  // de Permuta.nomeContraparte: puramente informativo, nunca lido pelo
  // motor financeiro (src/core nunca sabe quem comprou, so quanto e quando).
  comprador           String?
  documentoComprador  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  empreendimento    Empreendimento         @relation(fields: [empreendimentoId], references: [id])
  cenario           Cenario                @relation(fields: [cenarioId], references: [id])
  unidade           Unidade                @relation(fields: [unidadeId], references: [id])
  condicaoPagamento CondicaoPagamento      @relation(fields: [condicaoPagamentoId], references: [id])
  recebimentos      RecebimentoProjetado[]
  distrato          Distrato?
  renegociacoes     RenegociacaoVenda[]

  @@map("venda")
}

/**
 * Distrato parcial (achado F17, docs/DECISOES.md — "distrato parcial"):
 * renegociacao que REDUZ o valor de uma venda ativa, mantendo a unidade
 * vendida (ao contrario de Distrato, que cancela a venda inteira e devolve
 * a unidade ao estoque). Registro nominal historico, 1:N com Venda (pode
 * haver mais de uma renegociacao ao longo do tempo) -- nunca lido pelo
 * motor: o motor sempre le Venda.valorVenda diretamente, ja atualizado.
 */
model RenegociacaoVenda {
  id                 String   @id @default(cuid())
  empreendimentoId   String
  vendaId            String
  valorVendaAnterior String // decimal-as-string, o valor antes desta renegociacao
  novoValorVenda     String // decimal-as-string, o valor depois -- sempre menor que o anterior
  motivo             String?
  createdAt          DateTime @default(now())

  empreendimento Empreendimento @relation(fields: [empreendimentoId], references: [id])
  venda          Venda          @relation(fields: [vendaId], references: [id])

  @@map("renegociacao_venda")
}

model RecebimentoProjetado {
  id             String  @id @default(cuid())
  vendaId        String
  modalidadeId   String
  mesCompetencia Int
  valorPrevisto  String // decimal-as-string
  valorRealizado String?
  status         String  @default("previsto") // previsto | recebido | atrasado

  venda      Venda               @relation(fields: [vendaId], references: [id])
  modalidade ModalidadePagamento @relation(fields: [modalidadeId], references: [id])

  // O motor nunca gera duas parcelas da mesma modalidade, da mesma venda, no
  // mesmo mes (ver src/core/motorRecebimentos.ts) — a chave e usada para
  // recalcular o previsto por upsert sem trocar o id de uma linha que ja
  // tem valorRealizado gravado (ver src/db/servicoMotor.ts).
  @@unique([vendaId, modalidadeId, mesCompetencia])
  @@map("recebimento_projetado")
}

model CategoriaCusto {
  id               String  @id @default(cuid())
  empreendimentoId String? // nulo = categoria padrao do sistema, reutilizavel entre empreendimentos
  nome             String
  tipoIncidencia   String // fixo | pct_vgv | pct_execucao | pct_recebido

  empreendimento Empreendimento? @relation(fields: [empreendimentoId], references: [id])
  custos         Custo[]

  @@map("categoria_custo")
}

model Custo {
  id                  String   @id @default(cuid())
  empreendimentoId    String
  cenarioId           String
  categoriaId         String
  // Escopo opcional por tipologia (achado F11, docs/DECISOES.md — "estrutura
  // de comissao"): nulo = aplica a todas as vendas do cenario (comportamento
  // original); preenchido = so incide sobre vendas daquela tipologia. So faz
  // sentido quando a categoria tem tipoIncidencia="pct_vgv_vendido_no_mes"
  // (validado na API, nao aqui) -- permite percentuais de comissao
  // diferentes por tipologia sem nenhuma tabela nova.
  tipologiaId         String?
  valorPrevisto       String? // decimal-as-string, absoluto (quando incidencia = fixo)
  percentual          String? // decimal-as-string, 0..1 (quando incidencia = percentual)
  competenciaMes      Int?
  vencimentoMes       Int?
  recorrencia         String   @default("unico") // unico | mensal
  valorRealizado      String?
  participaFluxoCaixa Boolean  @default(true)
  status              String   @default("previsto")
  // Grupo de indice de correcao monetaria que corrige este custo (achado
  // F20, docs/DECISOES.md — "correcao monetaria por indice diferenciado"):
  // "padrao" segue a mesma serie que corrige as vendas e os demais custos
  // do cenario (comportamento identico a antes desta fatia); qualquer
  // outro valor usa a serie de IndiceCorrecao cadastrada com o mesmo
  // grupo (ex.: "obra" corrigida por INCC), ou fator 1 se nenhuma existir
  // com aquele nome.
  grupoIndiceCorrecao String   @default("padrao")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  empreendimento Empreendimento @relation(fields: [empreendimentoId], references: [id])
  cenario        Cenario        @relation(fields: [cenarioId], references: [id])
  categoria      CategoriaCusto @relation(fields: [categoriaId], references: [id])
  tipologia      Tipologia?     @relation(fields: [tipologiaId], references: [id])
  destinatarios  DestinatarioComissao[]
  desembolsos    DesembolsoCusto[]
  faixas         FaixaComissao[]

  @@map("custo")
}

/**
 * Uma parcela mensal computada pelo motor para um Custo de incidencia
 * percentual (achado F21, docs/DECISOES.md — "realizado para custos
 * percentuais"). Custo fixo continua usando Custo.valorRealizado/.status
 * diretamente (achado da setima fatia) -- essa tabela so existe porque um
 * custo percentual gera VARIAS parcelas (uma por mes, recalculadas a cada
 * rodada do motor), sem um unico lugar na linha do Custo para marcar como
 * paga. Mesmo padrao de RecebimentoProjetado: persistida so para guardar
 * valorRealizado/status entre recalculos (nunca para o motor ler de volta
 * -- valorPrevisto e sempre regenerado a partir de Custo+Venda+Cronograma),
 * com upsert por chave (custoId, mes) em vez de delete+recreate, para o id
 * da linha nao mudar sob uma acao "marcar como pago" ja em andamento na
 * tela (mesmo achado da setima fatia).
 */
model DesembolsoCusto {
  id             String  @id @default(cuid())
  custoId        String
  mes            Int
  valorPrevisto  String // decimal-as-string, sempre regenerado pelo motor -- nunca editado pelo usuario
  valorRealizado String?
  status         String  @default("previsto")

  // onDelete: Cascade — ver nota em DestinatarioComissao abaixo (achado F29).
  custo Custo @relation(fields: [custoId], references: [id], onDelete: Cascade)

  @@unique([custoId, mes])
  @@map("desembolso_custo")
}

// Cadastro nominal de quem recebe a comissao de um Custo, e como ela se
// divide (achado F13, docs/DECISOES.md) -- mesmo padrao de Permuta/Distrato:
// registro historico/informativo, nunca lido pelo motor. Nao restrito a
// custos de uma tipoIncidencia especifica (o motor nunca sabe o que e
// "comissao" -- essa classificacao e do usuario, nao do sistema).
model DestinatarioComissao {
  id              String   @id @default(cuid())
  custoId         String
  nome            String
  percentualSplit String // decimal-as-string, 0..1 -- fatia da comissao deste custo que este destinatario recebe
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // onDelete: Cascade (fechamento/hardening da Fase 1, docs/DECISOES.md —
  // achado F29): DestinatarioComissao/FaixaComissao/DesembolsoCusto so
  // existem em funcao de um Custo, nunca tem sentido de negocio
  // independente -- apagar o Custo deve sempre apagar as tres junto, sem
  // depender de codigo de aplicacao lembrar de replicar deleteMany() em
  // TODO caminho que apaga Custo em lote. Antes desta fatia, essa limpeza
  // so existia em excluirCusto() (achado F13) -- excluirEmpreendimento() e
  // excluirCenario() tambem apagam Custo em lote e nunca receberam a mesma
  // limpeza para DestinatarioComissao, causando um erro 500 real e
  // reproduzivel ao excluir um empreendimento/cenario com split nominal de
  // comissao cadastrado (encontrado na auditoria tecnica da Fase 1).
  custo Custo @relation(fields: [custoId], references: [id], onDelete: Cascade)

  @@map("destinatario_comissao")
}

// Uma faixa de uma tabela de comissao progressiva por volume de VGV vendido
// acumulado (achado F28, docs/DECISOES.md — "faixas de comissao
// progressivas por volume vendido"): cada Custo com
// CategoriaCusto.tipoIncidencia="faixas_vgv_acumulado" tem uma ou mais
// faixas, com volumeAte estritamente crescente e no maximo uma faixa aberta
// (volumeAte=null, sem limite superior), sempre a ultima -- validado na API
// a cada criacao/edicao (src/db/cadastro.ts), nunca no schema. O motor lê
// toda a lista e decide sozinho (src/core/motorCustos.ts); Custo.percentual
// fica sem uso para este tipo de incidencia.
model FaixaComissao {
  id         String   @id @default(cuid())
  custoId    String
  volumeAte  String? // decimal-as-string, limite superior de VGV acumulado desta faixa -- nulo = faixa aberta, sem limite
  percentual String // decimal-as-string, 0..1
  createdAt  DateTime @default(now())

  // onDelete: Cascade — ver nota em DestinatarioComissao acima (achado F29).
  custo Custo @relation(fields: [custoId], references: [id], onDelete: Cascade)

  @@map("faixa_comissao")
}

model CronogramaFisicoFinanceiro {
  id                       String @id @default(cuid())
  empreendimentoId         String
  cenarioId                String
  mes                      Int
  percentualExecucaoMensal String // decimal-as-string
  previstoRealizado        String @default("previsto")

  empreendimento Empreendimento @relation(fields: [empreendimentoId], references: [id])
  cenario        Cenario        @relation(fields: [cenarioId], references: [id])

  @@unique([cenarioId, mes])
  @@map("cronograma_fisico_financeiro")
}

/**
 * Serie de indice de correcao monetaria por mes do cenario (achado F6,
 * docs/DECISOES.md) -- ex.: variacao mensal do INCC ou IGP-M. Cada mes e
 * independente (sem soma obrigatoria, ao contrario do cronograma R6): um
 * usuario pode cadastrar so os meses ja conhecidos e completar a serie aos
 * poucos conforme novos indices sao divulgados. Nunca persistido como
 * "valor corrigido" em RecebimentoProjetado -- e sempre recomputado on the
 * fly a partir desta serie, no mesmo espirito do achado F1 (fluxo de caixa
 * nunca e uma tabela).
 *
 * Estendido (achado F20) com `grupo`: um cenario pode ter mais de uma
 * serie, cada uma identificada por um nome livre ("padrao", "obra", ...).
 * Vendas sempre corrigem pela serie "padrao" -- so Custo (via
 * Custo.grupoIndiceCorrecao) pode optar por seguir uma serie diferente.
 */
model IndiceCorrecao {
  id               String @id @default(cuid())
  empreendimentoId String
  cenarioId        String
  grupo            String @default("padrao")
  mes              Int
  percentual       String // decimal-as-string, variacao do indice naquele mes (pode ser negativo)

  empreendimento Empreendimento @relation(fields: [empreendimentoId], references: [id])
  cenario        Cenario        @relation(fields: [cenarioId], references: [id])

  @@unique([cenarioId, grupo, mes])
  @@map("indice_correcao")
}

/**
 * Cancelamento de uma venda (achado F7, docs/DECISOES.md):
 * Venda.status='distratada' ja e suficiente para o motor financeiro --
 * rodarMotorParaCenario() so busca vendas status="ativa" (src/db/servicoMotor.ts),
 * entao uma venda distratada some do fluxo de caixa e seus
 * RecebimentoProjetado sao limpos automaticamente por persistirRecebimentos
 * no proximo recalculo, sem nenhuma mudanca necessaria no motor. Esta
 * tabela e so o registro nominal do que aconteceu -- quanto ja tinha sido
 * recebido e quanto foi retido -- nunca lida pelo motor, mesmo padrao do
 * achado F3 (Permuta).
 */
model Distrato {
  id                       String   @id @default(cuid())
  empreendimentoId         String
  vendaId                  String   @unique
  dataDistrato             DateTime @default(now())
  valorRecebidoAteDistrato String // decimal-as-string, soma dos RecebimentoProjetado.valorRealizado ja marcados "recebido" no momento do distrato
  percentualRetencao       String // decimal-as-string, 0..1 -- fracao do valor recebido que a incorporadora retem
  valorRetido              String // decimal-as-string = valorRecebidoAteDistrato * percentualRetencao
  valorReembolsar          String // decimal-as-string = valorRecebidoAteDistrato - valorRetido
  motivo                   String?

  empreendimento Empreendimento @relation(fields: [empreendimentoId], references: [id])
  venda          Venda          @relation(fields: [vendaId], references: [id])

  @@map("distrato")
}

/**
 * Financiamento bancario de producao (achado F8, docs/DECISOES.md): ao
 * contrario de correcao monetaria e sensibilidade (camadas de leitura por
 * cima do motor, nunca persistidas), financiamento MUDA o fluxo de caixa
 * de verdade -- liberacoes (atreladas a curva do cronograma fisico) sao
 * uma entrada real, e a amortizacao (paga de uma vez, no mes configurado)
 * e uma saida real, ambas somadas ao fluxo consolidado antes de
 * calcularIndicadores(). Um financiamento por cenario (1:1) nesta fase --
 * sem isso, o cenario simplesmente nao tem financiamento, exatamente como
 * hoje.
 */
model FinanciamentoProducao {
  id                String   @id @default(cuid())
  empreendimentoId  String
  cenarioId         String   @unique
  valorContratado   String // decimal-as-string, teto do financiamento
  taxaJurosMensal   String // decimal-as-string, 0..1 -- juros capitalizados mes a mes sobre o saldo devedor, ate a amortizacao comecar
  mesAmortizacao    Int // mes em que a amortizacao comeca -- pagamento unico ("unico") ou primeira parcela (SAC/Price)
  // Tabela de amortizacao (achado F16, docs/DECISOES.md): "unico" preserva o
  // comportamento original (saldo devedor inteiro pago de uma vez, sem
  // numeroParcelas); "sac"/"price" amortizam o saldo ao longo de
  // numeroParcelas meses a partir de mesAmortizacao.
  tipoAmortizacao   String   @default("unico") // unico | sac | price
  numeroParcelas    Int? // obrigatorio quando tipoAmortizacao != "unico"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  empreendimento Empreendimento @relation(fields: [empreendimentoId], references: [id])
  cenario        Cenario        @relation(fields: [cenarioId], references: [id])

  @@map("financiamento_producao")
}
