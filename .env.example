# Copie para .env e ajuste. Nenhum valor aqui é segredo.
DATABASE_URL="file:./dev.db"
# Porta da API (padrão 3333)
PORT=3333
# Origens permitidas para o navegador (padrão: tela em localhost:5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Tentativas de login por minuto, por IP (padrão 20)
# RATE_LIMIT_LOGIN_MAX=20
